{
  "manifest_version": 3,
  "name": "SKL 坐标助手",
  "description": "为 SKL 签到页管理并提供预登记的 WGS-84 坐标。",
  "version": "0.1.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://skl.hdu.edu.cn/*"
  ],
  "action": {
    "default_title": "SKL 坐标助手",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://skl.hdu.edu.cn/*"
      ],
      "js": [
        "src/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://skl.hdu.edu.cn/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
