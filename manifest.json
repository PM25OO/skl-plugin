{
  "manifest_version": 3,
  "name": "SKL 坐标助手",
  "description": "为 SKL 签到页管理预登记坐标，并按需改写签到码。",
  "version": "0.4.0",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://skl.hdu.edu.cn/*"
  ],
  "action": {
    "default_title": "SKL 坐标助手",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup/popup.html"
      ],
      "matches": [
        "https://skl.hdu.edu.cn/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://skl.hdu.edu.cn/*"
      ],
      "js": [
        "src/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://skl.hdu.edu.cn/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js",
        "src/panel.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
